---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, SOCIAL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE_DESCRIPTION, image, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;

const nav = [
  { href: '/reviews/', label: 'Reviews' },
  { href: '/places/', label: 'Places' },
  { href: '/about/', label: 'About' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
    <meta name="theme-color" content="#eef2f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1a2e" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="airmail" aria-hidden="true"></div>

    <header class="site-header wrap">
      <a class="brand" href="/" aria-label={`${SITE_TITLE}, home`}>
        <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="2" />
          <circle cx="20" cy="20" r="12.5" fill="none" stroke="currentColor" stroke-width="1" />
          <path d="M11 20h18M20 11v18" stroke="currentColor" stroke-width="1" />
        </svg>
        <span>{SITE_TITLE}</span>
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="footer-about">
          <strong>{SITE_TITLE}</strong> is a personal travel journal by {AUTHOR}. No sponsored flights, no affiliate links.
        </p>
        <ul class="footer-links">
          <li><a href="/rss.xml">RSS feed</a></li>
          {SOCIAL.instagram && <li><a href={SOCIAL.instagram} rel="me">Instagram</a></li>}
          {SOCIAL.email && <li><a href={`mailto:${SOCIAL.email}`}>Email</a></li>}
        </ul>
        <p class="footer-copy">© {year} {AUTHOR}</p>
      </div>
      <div class="airmail" aria-hidden="true"></div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
  }

  .brand-mark {
    width: 2rem;
    height: 2rem;
    color: var(--red);
    transform: rotate(-12deg);
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 0.4rem 0.75rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    border-radius: var(--radius-sm);
  }

  nav a:hover {
    color: var(--ink);
    background: var(--paper-deep);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--red);
    border-radius: 0;
  }

  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem 2rem;
    padding-block: 2rem 2.25rem;
  }

  .footer-about {
    max-width: 46ch;
  }

  .footer-about strong {
    color: var(--ink);
    font-weight: 600;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }

  .footer-links a {
    color: var(--muted);
  }

  .footer-copy {
    grid-column: 1 / -1;
  }

  @media (max-width: 40rem) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
