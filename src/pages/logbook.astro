---
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
import { getFlights, getStats, formatMinutes, fmt } from '../lib/flights';
import { getAirport } from '../data/airports';

const flights = getFlights();
const s = getStats(flights);

type Row = { name: string; sub?: string; count: number };
const breakdowns: { title: string; note?: string; rows: Row[]; limit: number }[] = [
  {
    title: 'Routes',
    note: 'Both directions together',
    rows: s.routes.map((r) => ({ name: `${r.a} – ${r.b}`, sub: `${getAirport(r.a).city} and ${getAirport(r.b).city}`, count: r.count })),
    limit: 8,
  },
  {
    title: 'Airports',
    note: 'Takeoffs and landings',
    rows: s.topAirports.map((r) => {
      const ap = getAirport(r.name);
      return { ...r, sub: ap.city === ap.country ? ap.city : `${ap.city}, ${ap.country}` };
    }),
    limit: 8,
  },
  { title: 'Airlines', rows: s.airlines, limit: 8 },
  { title: 'Aircraft', rows: s.aircraft, limit: 8 },
  { title: 'Cabins', rows: s.cabins, limit: 8 },
].filter((b) => b.rows.length > 0);

// The flight table, one group per year, newest first.
const byYear = s.years.map((y) => ({
  year: y.name,
  flights: flights.filter((f) => String(f.date.getUTCFullYear()) === y.name),
}));
const labelCodes = s.topAirports.slice(0, 12).map((a) => a.name);

// Flights per year as columns, including any years with no flights.
const yearCounts = new Map(s.years.map((y) => [Number(y.name), y.count]));
const lastYear = Math.max(...yearCounts.keys());
const perYear = s.firstYear
  ? Array.from({ length: lastYear - s.firstYear + 1 }, (_, i) => {
      const year = s.firstYear! + i;
      return { year, count: yearCounts.get(year) ?? 0 };
    })
  : [];
const yearMax = Math.max(1, ...perYear.map((y) => y.count));

const shortDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const laps = s.laps >= 0.1 ? s.laps.toFixed(1) : null;
---

<Base title="Logbook" description={`Every flight Leo has logged: ${fmt(s.count)} flights and ${fmt(s.km)} km so far.`}>
  <div class="wrap">
    <header class="head">
      <h1>Logbook</h1>
      {
        s.count > 0 ? (
          <p class="totals">
            {fmt(s.count)} {s.count === 1 ? 'flight' : 'flights'}
            {s.firstYear && <> since {s.firstYear}</>} and {fmt(s.km)} km ({fmt(s.miles)} miles) in the air
            {laps ? <>, enough to go around the Earth {laps} times.</> : '.'}
          </p>
        ) : (
          <p class="totals">No flights logged yet. Add them in src/data/flights.yaml.</p>
        )
      }
      {s.hasSamples && <p class="notice">These are sample flights for now. Real ones are on the way.</p>}
    </header>

    {
      s.count > 0 && (
        <div class="overview">
        <RouteMap routes={s.routes} airports={s.airports} labelCodes={labelCodes} animate interactive class="map" />
        <dl class="facts">
          {s.minutes > 0 && (
            <div>
              <dt>Time in the air</dt>
              <dd>
                {fmt(Math.round(s.minutes / 60))} hours{!s.allTimed && <span class="fine"> (flights with a logged time)</span>}
              </dd>
            </div>
          )}
          <div>
            <dt>Airports</dt>
            <dd>{s.airports.length}</dd>
          </div>
          <div>
            <dt>Countries and regions</dt>
            <dd>{s.countries.length}</dd>
          </div>
          <div>
            <dt>Airlines</dt>
            <dd>{s.airlines.length}</dd>
          </div>
          {s.longest && (
            <div>
              <dt>Longest flight</dt>
              <dd>
                {s.longest.from} – {s.longest.to}, {fmt(Math.round(s.longest.km))} km
              </dd>
            </div>
          )}
        </dl>
        </div>
      )
    }

    {
      breakdowns.length > 0 && (
        <div class="breakdowns">
          {breakdowns.map((b) => {
            const max = Math.max(...b.rows.map((r) => r.count));
            return (
              <section aria-labelledby={`bd-${b.title}`}>
                <h2 id={`bd-${b.title}`}>{b.title}</h2>
                {b.note && <p class="bd-note">{b.note}</p>}
                <ol class="bars">
                  {b.rows.slice(0, b.limit).map((r) => (
                    <li>
                      <span class="bar-name">
                        {r.name}
                        {r.sub && <span class="bar-sub">{r.sub}</span>}
                      </span>
                      <span class="bar-count">{r.count}</span>
                      <span class="bar-track" aria-hidden="true">
                        <span class="bar-fill" style={`width: ${(r.count / max) * 100}%`} />
                      </span>
                    </li>
                  ))}
                </ol>
                {b.rows.length > b.limit && <p class="bd-note">and {b.rows.length - b.limit} more</p>}
              </section>
            );
          })}
        </div>
      )
    }

    {
      perYear.length > 1 && (
        <section class="per-year" aria-labelledby="per-year-h">
          <h2 id="per-year-h">Flights per year</h2>
          <ol class="columns" style={`--n:${perYear.length}`}>
            {perYear.map((y) => (
              <li title={`${y.year}: ${y.count} ${y.count === 1 ? 'flight' : 'flights'}`}>
                <span class="col-plot">
                  <span class="col-count">{y.count || ''}</span>
                  <span class="col-bar" style={`height: ${(y.count / yearMax) * 82}%`} />
                </span>
                <span class="col-year">
                  <span class="full">{y.year}</span>
                  <span class="short" aria-hidden="true">’{String(y.year).slice(2)}</span>
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      s.count > 0 && (
        <section class="log" aria-labelledby="all-flights">
          <h2 id="all-flights">Every flight</h2>
          {byYear.map((group, gi) => (
            <details class="year" open={gi === 0}>
              <summary>
                <span class="year-name">{group.year}</span>
                <span class="year-count">
                  {group.flights.length} {group.flights.length === 1 ? 'flight' : 'flights'}
                </span>
              </summary>
              <table>
                <thead>
                  <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Flight</th>
                    <th scope="col">Route</th>
                    <th scope="col">Aircraft</th>
                    <th scope="col">Cabin</th>
                    <th scope="col" class="num">Distance</th>
                    <th scope="col" class="num">Time</th>
                    <th scope="col"><span class="visually-hidden">Review</span></th>
                  </tr>
                </thead>
                <tbody>
                  {group.flights.map((f) => (
                    <tr>
                      <td class="date" data-label="Date">{shortDate(f.date)}</td>
                      <td data-label="Flight">
                        {f.airline}
                        {f.flight && <span class="code"> {f.flight}</span>}
                      </td>
                      <td class="route" data-label="Route">
                        <span title={`${getAirport(f.from).city} to ${getAirport(f.to).city}`}>
                          {f.from} – {f.to}
                        </span>
                      </td>
                      <td data-label="Aircraft">{f.aircraft ?? ''}</td>
                      <td data-label="Cabin">{f.cabin ?? ''}{f.seat && <span class="fine">, seat {f.seat}</span>}</td>
                      <td class="num" data-label="Distance">{fmt(Math.round(f.km))} km</td>
                      <td class="num" data-label="Time">{f.minutes !== undefined ? formatMinutes(f.minutes) : ''}</td>
                      <td class="rev">{f.review && <a href={`/reviews/${f.review}/`}>Read review</a>}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          ))}
        </section>
      )
    }
  </div>
</Base>

<style>
  .head {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  .head h1 {
    font-size: var(--step-4);
  }

  .totals {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink);
    max-width: 34ch;
  }

  .notice {
    font-size: var(--step--1);
    color: var(--muted);
    border-left: 3px solid var(--red);
    padding-left: 0.75rem;
  }

   .overview {
    display: grid;
    gap: 1.5rem 4rem;
    align-items: center;
  }

  .overview :global(.map) {
    width: 100%;
    max-width: 36rem;
    justify-self: center;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.6rem;
    margin: 0;
  }

  @media (min-width: 56rem) {
    .overview {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
    .facts {
      flex-direction: column;
      gap: 1.4rem;
    }
  }

  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .facts dd {
    margin: 0.15rem 0 0;
    color: var(--ink);
    font-weight: 600;
    font-size: var(--step-1);
    font-variant-numeric: tabular-nums;
  }

  .fine {
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .breakdowns {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 2.5rem 3rem;
    margin-top: 4rem;
  }

  .breakdowns h2,
  .log h2 {
    font-size: var(--step-2);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .bd-note {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .bars {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
  }

  .bars li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 1rem;
    padding: 0.65rem 0 0.7rem;
  }

  .bar-name {
    color: var(--ink);
    font-weight: 550;
  }

  .bar-sub {
    display: block;
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .bar-count {
    color: var(--text);
    font-variant-numeric: tabular-nums;
    align-self: end;
  }

  .bar-track {
    grid-column: 1 / -1;
    height: 6px;
  }

  .bar-fill {
    display: block;
    height: 100%;
    min-width: 6px;
    background: var(--blue);
    border-radius: 0 3px 3px 0;
  }

  .log,
  .per-year {
    margin-top: 4rem;
  }

  .per-year h2 {
    font-size: var(--step-2);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .columns {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 6px;
    height: 13rem;
    align-items: stretch;
  }

  .columns li {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .col-plot {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
  }

  .col-count {
    font-size: var(--step--1);
    color: var(--text);
    font-variant-numeric: tabular-nums;
    padding-bottom: 0.25rem;
  }

  .col-bar {
    display: block;
    width: 100%;
    max-width: 2.6rem;
    background: var(--blue);
    border-radius: 3px 3px 0 0;
  }

  .col-year {
    font-size: var(--step--1);
    color: var(--muted);
    padding-top: 0.45rem;
    border-top: 1px solid var(--rule);
    width: 100%;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .col-year .short {
    display: none;
  }

  @media (max-width: 48rem) {
    .columns {
      gap: 3px;
    }
    .col-year .full {
      display: none;
    }
    .col-year .short {
      display: inline;
    }
    .col-count {
      font-size: 0.7rem;
    }
  }

  .year {
    border-bottom: 1px solid var(--rule);
  }

  .year summary {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
  }

  .year summary::-webkit-details-marker {
    display: none;
  }

  .year summary::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: translateY(-0.15rem) rotate(-45deg);
    transition: transform 0.15s ease;
  }

  .year[open] summary::before {
    transform: translateY(-0.3rem) rotate(45deg);
  }

  .year-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink);
  }

  .year-count {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .year table {
    margin-bottom: 1.25rem;
  }

  .year tr:last-child td {
    border-bottom: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th {
    text-align: left;
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--muted);
    padding: 0.6rem 0.8rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  td {
    padding: 0.8rem 0.8rem 0.8rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .date,
  .route {
    white-space: nowrap;
  }

  .route {
    color: var(--ink);
    font-weight: 600;
  }

  .code {
    color: var(--muted);
  }

  .rev {
    text-align: right;
    white-space: nowrap;
  }

  /* On narrow screens, each flight becomes a small stacked card. */
  @media (max-width: 48rem) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    table,
    tbody,
    tr,
    td {
      display: block;
    }
    tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.35rem 1rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--rule);
    }
    td {
      border: 0;
      padding: 0;
      text-align: left !important;
    }
    td:empty {
      display: none;
    }
    td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 0.78rem;
      color: var(--muted);
      font-weight: 400;
    }
    .rev {
      grid-column: 1 / -1;
    }
  }
</style>
