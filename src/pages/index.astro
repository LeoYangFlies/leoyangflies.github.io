---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Postmark from '../components/Postmark.astro';
import ReviewItem from '../components/ReviewItem.astro';
import RouteMap from '../components/RouteMap.astro';
import TipItem from '../components/TipItem.astro';
import FlightNow from '../components/FlightNow.astro';
import { getNow } from '../lib/now';
import { SITE_DESCRIPTION, TIPS_TITLE } from '../consts';
import { getReviews, reviewKind, reviewUrl, postmarkText, whereShort, whereLong } from '../lib/reviews';
import { getStats, fmt, routeLegs } from '../lib/flights';
import { getTips } from '../lib/tips';

const reviews = await getReviews();
// Lead with the newest trip report; fall back to the newest review of any kind.
const latest = reviews.find((r) => r.data.category === 'trip') ?? reviews[0];
const recent = reviews.filter((r) => r !== latest).slice(0, 6);
const stats = getStats();
const now = getNow();
const tips = (await getTips()).slice(0, 3);
const stamp = latest ? postmarkText(latest) : undefined;
---

<Base>
  <div class="wrap">
    {now.flying && <FlightNow from={now.from} to={now.to} />}
    <p class="intro">{SITE_DESCRIPTION}</p>

    {
      latest && stamp ? (
        <article class="feature">
          <a class="feature-cover" href={reviewUrl(latest)} tabindex="-1" aria-hidden="true">
            <Cover
              image={latest.data.cover}
              alt=""
              label={whereShort(latest)}
              ratio="3 / 2"
              sizes="(min-width: 72rem) 38rem, (min-width: 56rem) 55vw, 100vw"
              loading="eager"
            />
          </a>
          <div class="feature-text">
            <Postmark class="feature-stamp" top={stamp.top} bottom={stamp.bottom} date={latest.data.published} />
            <p class="feature-kind">
              {latest.data.category === 'trip' ? 'Latest trip report' : `Latest ${reviewKind(latest.data.category).toLowerCase()} review`}:{' '}
              {whereLong(latest)}
            </p>
            <h1 class="feature-title">
              <a href={reviewUrl(latest)}>{latest.data.title}</a>
            </h1>
          </div>
        </article>
      ) : (
        <div class="empty">
          <h1>Nothing posted yet</h1>
          <p>Add your first review as a Markdown file in src/content/reviews/ and it will appear here.</p>
        </div>
      )
    }

    {
      recent.length > 0 && (
        <section class="recent" aria-labelledby="recent-heading">
          <div class="section-head">
            <h2 id="recent-heading">More reviews</h2>
            <a href="/reviews/">All reviews</a>
          </div>
          <div class="recent-list">
            {recent.map((r) => (
              <ReviewItem review={r} variant="card" />
            ))}
          </div>
        </section>
      )
    }

    {
      tips.length > 0 && (
        <section class="tips" aria-labelledby="tips-heading">
          <div class="section-head">
            <h2 id="tips-heading">{TIPS_TITLE}</h2>
            <a href="/guides/">All guides</a>
          </div>
          <div class="tips-list">
            {tips.map((t) => (
              <TipItem tip={t} variant="card" />
            ))}
          </div>
        </section>
      )
    }

    {
      stats.count > 0 && (
        <section class="logbook" aria-labelledby="logbook-heading">
          <div class="section-head">
            <h2 id="logbook-heading">Logbook</h2>
            <a href="/logbook/">All flights and stats</a>
          </div>
          <div class="logbook-body">
            <a class="logbook-map" href="/logbook/" tabindex="-1" aria-hidden="true">
              <RouteMap legs={routeLegs()} airports={stats.airports} labels={false} arrows={false} />
            </a>
            <p class="logbook-totals">
              {fmt(stats.count)} {stats.count === 1 ? 'flight' : 'flights'}, {fmt(stats.km)} km, and{' '}
              {stats.airports.length} airports so far.
            </p>
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .intro {
    max-width: 38ch;
    font-size: var(--step-1);
    color: var(--muted);
    margin: 1.5rem 0 2rem;
    line-height: 1.45;
  }

  /* Featured latest post: the cover beside its title, with the postmark pressed over the join */
  .feature {
    position: relative;
    display: grid;
    gap: 0;
  }

  .feature-cover {
    display: block;
  }

  .feature-text {
    position: relative;
    display: grid;
    align-content: center;
    gap: 0.8rem;
    padding: 1.6rem 0 0;
  }

  /* Phones: the postmark sits on the cover's lower corner, clear of the text. */
  .feature-text :global(.feature-stamp) {
    position: absolute;
    right: 0.25rem;
    top: -4.4rem;
    width: 8.5rem;
    color: var(--red);
    transform: rotate(-9deg);
    pointer-events: none;
  }

  .feature-text {
    padding-right: 0;
  }

  .feature-kind {
    padding-right: 5rem;
  }

  .feature-kind {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--blue);
  }

  .feature-title {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .feature-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .feature-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 3px;
  }

  @media (min-width: 56rem) {
    .feature {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: center;
    }
    .feature-text {
      padding: 0;
    }
    .feature-kind {
      padding-right: 0;
    }
    /* Wider screens: the postmark is stamped under the title. */
    .feature-text :global(.feature-stamp) {
      position: static;
      order: 3;
      justify-self: start;
      width: 13rem;
      margin: 0.4rem 0 0 -0.4rem;
    }
  }

  .empty {
    padding: 3rem 0;
    display: grid;
    gap: 0.8rem;
  }

  /* Sections */
  .recent,
  .tips,
  .logbook {
    margin-top: 4.5rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .section-head h2 {
    font-size: var(--step-3);
  }

  .section-head a {
    font-weight: 500;
    white-space: nowrap;
  }

  .recent-list,
  .tips-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 2.4rem 2rem;
  }

  .logbook-body {
    display: grid;
    gap: 1.25rem 3rem;
    align-items: center;
  }

  @media (min-width: 56rem) {
    .logbook-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .logbook-map {
    display: block;
    max-width: 30rem;


  }

  .logbook-totals {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink);
    max-width: 22ch;
  }
</style>
