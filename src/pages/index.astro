---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Postmark from '../components/Postmark.astro';
import ReviewItem from '../components/ReviewItem.astro';
import RouteMap from '../components/RouteMap.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getReviews, reviewKind, reviewUrl, postmarkText, whereShort, whereLong } from '../lib/reviews';
import { getStats, fmt } from '../lib/flights';

const reviews = await getReviews();
const [latest, ...rest] = reviews;
const recent = rest.slice(0, 6);
const stats = getStats();
const stamp = latest ? postmarkText(latest) : undefined;
---

<Base>
  <div class="wrap">
    <p class="intro">{SITE_DESCRIPTION}</p>

    {
      latest && stamp ? (
        <article class="feature">
          <a class="feature-cover" href={reviewUrl(latest)} tabindex="-1" aria-hidden="true">
            <Cover
              image={latest.data.cover}
              alt=""
              label={whereShort(latest)}
              ratio="16 / 9"
              sizes="(min-width: 72rem) 70rem, 100vw"
              loading="eager"
            />
          </a>
          <div class="feature-text">
            <Postmark class="feature-stamp" top={stamp.top} bottom={stamp.bottom} date={latest.data.published} />
            <p class="feature-kind">
              Latest {reviewKind(latest.data.category).toLowerCase()} review: {whereLong(latest)}
            </p>
            <h1 class="feature-title">
              <a href={reviewUrl(latest)}>{latest.data.title}</a>
            </h1>
            <p class="feature-desc">{latest.data.description}</p>
          </div>
        </article>
      ) : (
        <div class="empty">
          <h1>Nothing posted yet</h1>
          <p>Add your first review as a Markdown file in src/content/reviews/ and it will appear here.</p>
        </div>
      )
    }

    {
      recent.length > 0 && (
        <section class="recent" aria-labelledby="recent-heading">
          <div class="section-head">
            <h2 id="recent-heading">More reviews</h2>
            <a href="/reviews/">All reviews</a>
          </div>
          <div class="recent-list">
            {recent.map((r) => (
              <ReviewItem review={r} />
            ))}
          </div>
        </section>
      )
    }

    {
      stats.count > 0 && (
        <section class="logbook" aria-labelledby="logbook-heading">
          <div class="section-head">
            <h2 id="logbook-heading">Logbook</h2>
            <a href="/logbook/">All flights and stats</a>
          </div>
          <div class="logbook-body">
            <a class="logbook-map" href="/logbook/" tabindex="-1" aria-hidden="true">
              <RouteMap routes={stats.routes} airports={stats.airports} labels={false} />
            </a>
            <p class="logbook-totals">
              {fmt(stats.count)} {stats.count === 1 ? 'flight' : 'flights'}, {fmt(stats.km)} km, and{' '}
              {stats.airports.length} airports so far.
            </p>
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .intro {
    max-width: 38ch;
    font-size: var(--step-1);
    color: var(--muted);
    margin: 1.5rem 0 2rem;
    line-height: 1.45;
  }

  /* Featured latest review: wide cover with the postmark pressed over its edge */
  .feature {
    display: grid;
    gap: 0;
  }

  .feature-cover {
    display: block;
  }

  .feature-text {
    position: relative;
    display: grid;
    gap: 0.7rem;
    padding: 1.6rem 0 0;
    max-width: 44rem;
  }

  .feature-text :global(.feature-stamp) {
    position: absolute;
    right: -1rem;
    top: -4.5rem;
    width: 14rem;
    color: var(--red);
    transform: rotate(-9deg);
    pointer-events: none;
  }

  .feature-kind {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--blue);
  }

  .feature-title {
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .feature-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .feature-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 3px;
  }

  .feature-desc {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 44ch;
  }

  @media (min-width: 56rem) {
    .feature-text {
      max-width: none;
      padding-right: 24rem;
    }
    .feature-text :global(.feature-stamp) {
      right: -0.5rem;
      top: -3.25rem;
      width: 23rem;
    }
  }

  @media (max-width: 40rem) {
    .feature-text :global(.feature-stamp) {
      width: 10.5rem;
      top: -2.6rem;
      right: 0;
    }
  }

  .empty {
    padding: 3rem 0;
    display: grid;
    gap: 0.8rem;
  }

  /* Sections */
  .recent,
  .logbook {
    margin-top: 4.5rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .section-head h2 {
    font-size: var(--step-3);
  }

  .section-head a {
    font-weight: 500;
    white-space: nowrap;
  }

  .recent-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: 2.2rem 3rem;
  }

  .logbook-body {
    display: grid;
    gap: 1.25rem 3rem;
    align-items: center;
  }

  @media (min-width: 56rem) {
    .logbook-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .logbook-map {
    display: block;
    max-width: 30rem;


  }

  .logbook-totals {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink);
    max-width: 22ch;
  }
</style>
