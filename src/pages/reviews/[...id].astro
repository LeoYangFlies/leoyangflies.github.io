---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Postmark from '../../components/Postmark.astro';
import { getAirport, distanceKm } from '../../data/airports';
import { getReviews, categoryLabel, formatDate, reviewUrl, postmarkText, whereLong, whereShort, type Review } from '../../lib/reviews';

export async function getStaticPaths() {
  const reviews = await getReviews();
  return reviews.map((review, i) => ({
    params: { id: review.id },
    props: { review, newer: reviews[i - 1], older: reviews[i + 1] },
  }));
}

interface Props {
  review: Review;
  newer?: Review;
  older?: Review;
}

const { review, newer, older } = Astro.props;
const { data } = review;
const { Content } = await render(review);
const ogImage = data.cover ? (await getImage({ src: data.cover, width: 1200, format: 'jpg' })).src : undefined;
const hasSummary = data.verdict || data.liked.length || data.disliked.length;
const isFlight = data.category === 'flight' && data.from && data.to;
const stamp = postmarkText(review);

// The facts row under the title: flight details for flights, place details otherwise.
const facts: { label: string; value: string }[] = isFlight
  ? [
      { label: 'Route', value: `${getAirport(data.from!).city} ${data.from} to ${getAirport(data.to!).city} ${data.to}` },
      { label: 'Flight', value: [data.airline, data.flight].filter(Boolean).join(' ') },
      ...(data.aircraft ? [{ label: 'Aircraft', value: data.aircraft }] : []),
      ...(data.cabin ? [{ label: 'Cabin', value: data.seat ? `${data.cabin}, seat ${data.seat}` : data.cabin }] : []),
      ...(data.duration ? [{ label: 'Flight time', value: data.duration }] : []),
      { label: 'Distance', value: `${Math.round(distanceKm(data.from!, data.to!)).toLocaleString('en-US')} km` },
      ...(data.when ? [{ label: 'Flown', value: data.when }] : []),
    ]
  : [
      { label: 'Where', value: whereLong(review) },
      ...(data.when ? [{ label: 'Visited', value: data.when }] : []),
    ];
---

<Base title={data.title} description={data.description} image={ogImage} type="article">
  <article class="wrap review">
    <header class="head">
      <p class="crumbs">
        <a href="/reviews/">Reviews</a>
        <span aria-hidden="true">/</span>
        <a href={`/reviews/#${data.category}`}>{categoryLabel(data.category)}</a>
      </p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>

      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    {
      data.cover && (
        <figure class="hero">
          <Cover
            image={data.cover}
            alt={data.coverAlt ?? ''}
            label={whereShort(review)}
            ratio="16 / 9"
            sizes="(min-width: 72rem) 70rem, 100vw"
            loading="eager"
          />
        </figure>
      )
    }

    <div class="layout">
      <div class="prose">
        <Content />
      </div>

      {
        hasSummary && (
          <aside class="verdict" aria-labelledby="verdict-heading">
            <Postmark class="verdict-stamp" top={stamp.top} bottom={stamp.bottom} date={data.published} bars={false} />
            <h2 id="verdict-heading">In short</h2>
            {data.verdict && <p class="verdict-line">{data.verdict}</p>}
            {data.liked.length > 0 && (
              <div class="pros">
                <h3>Liked</h3>
                <ul>
                  {data.liked.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
            {data.disliked.length > 0 && (
              <div class="cons">
                <h3>Could be better</h3>
                <ul>
                  {data.disliked.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        )
      }
    </div>

    <footer class="foot">
      <p class="dates">
        Published {formatDate(data.published)}{data.updated && <>, updated {formatDate(data.updated)}</>}
      </p>
      {
        (newer || older) && (
          <nav class="pager" aria-label="More reviews">
            {older ? (
              <a class="older" href={reviewUrl(older)}>
                <span class="pager-label">Older</span>
                <span class="pager-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="newer" href={reviewUrl(newer)}>
                <span class="pager-label">Newer</span>
                <span class="pager-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>
</Base>

<style>
  .head {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 2.2rem;
    max-width: 50rem;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .head h1 {
    font-size: var(--step-4);
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    max-width: 48ch;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 2.2rem;
    margin: 0.4rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .facts dd {
    margin: 0.1rem 0 0;
    color: var(--ink);
    font-weight: 550;
  }

  .hero {
    margin: 0 0 3rem;
  }

  .layout {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 4rem;
    }
    .verdict {
      position: sticky;
      top: 1.5rem;
    }
  }

  /* The verdict reads like the back of a postcard */
  .verdict {
    position: relative;
    display: grid;
    gap: 0.9rem;
    padding: 1.6rem 1.5rem 1.7rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .verdict :global(.verdict-stamp) {
    position: absolute;
    right: -2rem;
    top: -2rem;
    width: 6.5rem;
    color: var(--red);
    opacity: 0.35;
    transform: rotate(14deg);
    pointer-events: none;
  }

  .verdict h2 {
    font-size: var(--step-2);
    padding-right: 3rem;
  }

  .verdict-line {
    padding-right: 1.5rem;
  }

  .verdict-line {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .verdict h3 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 650;
    margin-bottom: 0.35rem;
  }

  .verdict ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: 0.97rem;
  }

  .verdict li {
    position: relative;
    padding-left: 1.3rem;
  }

  .pros li::before,
  .cons li::before {
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  .pros li::before {
    content: '+';
    color: var(--blue);
  }

  .cons li::before {
    content: '–';
    color: var(--red);
  }

  .foot {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 2rem;
  }

  .dates {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .pager a {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
  }

  .newer {
    text-align: right;
  }

  .pager-label {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    line-height: 1.3;
  }

  .pager a:hover .pager-title {
    text-decoration: underline;
    text-decoration-color: var(--red);
  }

  @media (max-width: 36rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .newer {
      text-align: left;
    }
  }
</style>
