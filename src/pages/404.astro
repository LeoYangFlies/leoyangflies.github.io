---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="wrap lost">
    <svg class="stamp" viewBox="0 0 140 140" aria-hidden="true">
      <g fill="none" stroke="currentColor">
        <circle cx="70" cy="70" r="64" stroke-width="3" />
        <circle cx="70" cy="70" r="58" stroke-width="1.2" />
      </g>
      <text x="70" y="64" fill="currentColor" font-family="var(--font-body)" font-weight="700" font-size="13" text-anchor="middle" letter-spacing="2">RETURN TO</text>
      <text x="70" y="84" fill="currentColor" font-family="var(--font-body)" font-weight="700" font-size="13" text-anchor="middle" letter-spacing="2">SENDER</text>
    </svg>
    <h1>This page doesn't exist</h1>
    <p>The link may be old, or the address may have a typo.</p>
    <p><a href="/">Go to the home page</a> or <a href="/reviews/">browse all reviews</a>.</p>
  </div>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    padding-block: 3rem;
  }

  .stamp {
    width: 9rem;
    color: var(--red);
    transform: rotate(-10deg);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: var(--step-4);
  }

  p {
    font-size: var(--step-1);
    color: var(--muted);
  }
</style>
