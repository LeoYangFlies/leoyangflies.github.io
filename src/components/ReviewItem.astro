---
// One review in a list. Two looks:
// - "row" (inside articles): small square cover beside where, kind, title and summary;
// - "card" (home page and the Reviews page): a big cover with where, kind and title under it.
import Cover from './Cover.astro';
import { formatDate, formatRange, reviewKind, reviewUrl, whereShort, whereLong, type Review } from '../lib/reviews';

interface Props {
  review: Review;
  headingLevel?: 'h2' | 'h3';
  variant?: 'row' | 'card';
}

const { review, headingLevel = 'h3', variant = 'row' } = Astro.props;
const card = variant === 'card';
const { data } = review;
const Heading = headingLevel;
const isFlight = data.category === 'flight';
const isTrip = data.category === 'trip';
const kind = isTrip ? 'Trip report' : reviewKind(data.category);
// When it happened: a trip's dates, a hotel stay's check-in to check-out, or the day flown or visited.
const day = 24 * 60 * 60 * 1000;
const when = isTrip && data.start && data.end
  ? formatRange(data.start, data.end)
  : data.date && data.nights
    ? formatRange(data.date, new Date(data.date.valueOf() + data.nights * day))
    : data.date
      ? formatDate(data.date)
      : data.when;
---

<article class:list={['item', { card }]} data-category={data.category}>
  <a class="thumb" href={reviewUrl(review)} tabindex="-1" aria-hidden="true">
    {
      card ? (
        <Cover
          image={data.cover}
          alt=""
          label={whereShort(review)}
          ratio="3 / 2"
          widths={[400, 700, 1000]}
          sizes="(min-width: 72rem) 23rem, (min-width: 44rem) 46vw, 100vw"
        />
      ) : (
        <Cover image={data.cover} alt="" label={whereShort(review)} ratio="1 / 1" widths={[200, 400]} sizes="8rem" />
      )
    }
  </a>
  <div class="body">
    <div class="meta">
      <p class="where">
        <span class="kind">{kind}</span>
        <span>{isFlight || isTrip ? whereShort(review) : whereLong(review)}</span>
        {isFlight && data.airline && <span>{[data.airline, data.flight].filter(Boolean).join(' ')}</span>}
      </p>
      {when && <p class="when">{when}</p>}
    </div>
    <Heading class="title"><a href={reviewUrl(review)}>{data.title}</a></Heading>
    {!card && <p class="desc">{data.description}</p>}
  </div>
</article>

<style>
  .item {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .thumb {
    display: block;
  }

  .body {
    display: grid;
    gap: 0.4rem;
  }

  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .meta {
    display: grid;
    gap: 0.15rem;
  }

  .when {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .kind {
    color: var(--blue);
    font-weight: 600;
  }

  .title {
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--red);
  }

  .desc {
    color: var(--text);
    font-size: 0.98rem;
    max-width: 52ch;
  }

  .card {
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .card .thumb :global(.cover) {
    transition: filter 0.2s ease;
  }

  .card:hover .thumb :global(.cover) {
    filter: brightness(1.05) saturate(1.05);
  }

  .card .title {
    font-size: var(--step-2);
    line-height: 1.2;
  }

  @media (max-width: 30rem) {
    .item:not(.card) {
      grid-template-columns: 5rem 1fr;
      gap: 0.9rem;
    }
  }
</style>
