---
// One tip in a list: its topic as a luggage tag, the title, a one-line summary.
import { readingMinutes, tipUrl, topicLabel, type Tip } from '../lib/tips';

interface Props {
  tip: Tip;
  headingLevel?: 'h2' | 'h3';
}

const { tip, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="tip" data-topic={tip.data.topic}>
  <p class="meta">
    <span class="tag">{topicLabel(tip.data.topic)}</span>
    <span>{readingMinutes(tip)} min read</span>
  </p>
  <Heading class="title"><a href={tipUrl(tip)}>{tip.data.title}</a></Heading>
  <p class="desc">{tip.data.description}</p>
</article>

<style>
  .tip {
    display: grid;
    gap: 0.45rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* A small luggage tag: a label with a punched hole at one end. */
  .tag {
    position: relative;
    padding: 0.12rem 0.6rem 0.12rem 1.35rem;
    border: 1.5px solid var(--blue);
    border-radius: 3px 999px 999px 3px;
    color: var(--blue);
    font-weight: 600;
    line-height: 1.3;
  }

  .tag::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 50%;
    width: 0.4rem;
    height: 0.4rem;
    margin-top: -0.2rem;
    border: 1.5px solid var(--blue);
    border-radius: 50%;
  }

  .title {
    font-size: var(--step-2);
    line-height: 1.2;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--red);
  }

  .desc {
    max-width: 58ch;
  }
</style>
