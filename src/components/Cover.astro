---
// A review's cover photo, or a quiet stand-in when the review has no photo yet.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  place: string;
  widths?: number[];
  sizes?: string;
  ratio?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  image,
  alt = '',
  place,
  widths = [480, 800, 1200, 1600],
  sizes = '100vw',
  ratio = '3 / 2',
  loading = 'lazy',
  class: className,
} = Astro.props;

// Pick one of a few paper tints from the place name, so stand-ins vary but stay stable.
const tints = ['tint-a', 'tint-b', 'tint-c'];
const tint = tints[[...place].reduce((sum, c) => sum + c.charCodeAt(0), 0) % tints.length];
---

<div class:list={['cover', className, !image && tint]} style={`aspect-ratio: ${ratio}`}>
  {
    image ? (
      <Image src={image} alt={alt} widths={widths} sizes={sizes} loading={loading} />
    ) : (
      <span class="stand-in" aria-hidden="true">
        {place}
      </span>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-deep);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stand-in {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0.5em 0.6em;
    font-family: var(--font-display);
    /* scale with the box so the whole name fits, small thumbnail or wide banner */
    font-size: min(19cqi, 5.5rem);
    line-height: 0.95;
    overflow-wrap: anywhere;
    color: color-mix(in srgb, var(--ink) 22%, transparent);
    overflow: hidden;
  }

  .tint-a {
    background: #d8e3ee;
  }
  .tint-b {
    background: #e3e0ea;
  }
  .tint-c {
    background: #dbe6e1;
  }

  @media (prefers-color-scheme: dark) {
    .tint-a {
      background: #1c2c49;
    }
    .tint-b {
      background: #262a45;
    }
    .tint-c {
      background: #1b3036;
    }
    .stand-in {
      color: color-mix(in srgb, var(--ink) 18%, transparent);
    }
  }
</style>
