---
// Shows a 0–5 rating (half points allowed) as five dots, plus the number.
interface Props {
  value: number;
  size?: 'small' | 'large';
}

const { value, size = 'small' } = Astro.props;
const dots = [1, 2, 3, 4, 5].map((n) => (value >= n ? 'full' : value >= n - 0.5 ? 'half' : 'empty'));
const label = `Rated ${value} out of 5`;
---

<span class:list={['rating', size]} role="img" aria-label={label}>
  <span class="dots" aria-hidden="true">
    {dots.map((d) => <span class:list={['dot', d]}></span>)}
  </span>
  <span class="num" aria-hidden="true">{Number.isInteger(value) ? value : value.toFixed(1)}</span>
</span>

<style>
  .rating {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    white-space: nowrap;
  }

  .dots {
    display: inline-flex;
    gap: 0.22em;
  }

  .dot {
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    border: 1.5px solid var(--red);
  }

  .dot.full {
    background: var(--red);
  }

  .dot.half {
    background: linear-gradient(90deg, var(--red) 50%, transparent 50%);
  }

  .num {
    font-weight: 650;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .large {
    font-size: 1.4rem;
  }

  .large .dot {
    border-width: 2px;
  }
</style>
