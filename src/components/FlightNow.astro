---
// The home page banner shown only while Leo is in the air: the two cities and a small
// globe with a plane looping along the route. Deliberately no flight number, no times
// and no live position, so it never reveals when or where he lands.
import { geoGraticule10, geoInterpolate, geoOrthographic, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';
import { getAirport } from '../data/airports';

interface Props {
  from: string;
  to: string;
}

const { from, to } = Astro.props;
const a = getAirport(from);
const b = getAirport(to);
const fromCity = a.city;
const toCity = b.city;

const W = 420;
const H = 280;
const uid = Math.random().toString(36).slice(2, 8);
const mid = geoInterpolate([a.lon, a.lat], [b.lon, b.lat])(0.5);
const route = { type: 'LineString' as const, coordinates: [[a.lon, a.lat], [b.lon, b.lat]] };

const projection = geoOrthographic()
  .rotate([-mid[0], -Math.max(-60, Math.min(60, mid[1]))])
  .fitExtent(
    [
      [50, 46],
      [W - 50, H - 40],
    ],
    route,
  );
// Keep short hops from zooming in so far that the map loses its context.
if (projection.scale() > 1400) projection.scale(1400).translate([W / 2, H / 2]);
const path = geoPath(projection);

const land = path(feature(land110 as any, (land110 as any).objects.land) as any) ?? '';
const sphere = path({ type: 'Sphere' }) ?? '';
const graticule = path(geoGraticule10()) ?? '';
const arc = path(route) ?? '';
const [ax, ay] = projection([a.lon, a.lat])!;
const [bx, by] = projection([b.lon, b.lat])!;
// Put each code on the outer side of its dot so the two never overlap the route.
const labelDx = (x: number, other: number) => (x <= other ? -10 : 10);
const anchor = (x: number, other: number) => (x <= other ? 'end' : 'start');
---

<section class="flight-now" aria-label="Leo is in the air">
  <div class="stripe" aria-hidden="true"></div>
  <div class="inner">
    <div class="text">
      <p class="live"><span class="dot" aria-hidden="true"></span>In the air right now</p>
      <p class="headline">
        Leo is flying from <span class="city">{fromCity}</span> to <span class="city">{toCity}</span>.
      </p>
      <p class="sub">Reviews from this trip will follow once he's back on the ground.</p>
    </div>
    <svg class="map" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Route from ${fromCity} to ${toCity}`}>
      <defs>
        <clipPath id={`fn-clip-${uid}`}><path d={sphere} /></clipPath>
        <path id={`fn-arc-${uid}`} d={arc} />
      </defs>
      <g clip-path={`url(#fn-clip-${uid})`}>
        <path class="sea" d={sphere} />
        <path class="graticule" d={graticule} />
        <path class="land" d={land} />
      </g>
      <path class="sphere-edge" d={sphere} />
      <use href={`#fn-arc-${uid}`} class="route" />
      <circle class="end" cx={ax} cy={ay} r="4.5" />
      <circle class="end" cx={bx} cy={by} r="4.5" />
      <text class="code" x={ax + labelDx(ax, bx)} y={ay + 4} text-anchor={anchor(ax, bx)}>{from}</text>
      <text class="code" x={bx + labelDx(bx, ax)} y={by + 4} text-anchor={anchor(bx, ax)}>{to}</text>
      <g class="plane">
        <path d="M -9 -1.4 L 1 -1.4 L 6 -8 L 8.5 -8 L 5.5 -1.4 L 10 -1.4 Q 12.5 0 10 1.4 L 5.5 1.4 L 8.5 8 L 6 8 L 1 1.4 L -9 1.4 L -11 5 L -12.5 5 L -11.5 0 L -12.5 -5 L -11 -5 Z" />
        <animateMotion dur="9s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
          <mpath href={`#fn-arc-${uid}`} />
        </animateMotion>
      </g>
    </svg>
  </div>
</section>

<script>
  // With "reduce motion" on, park the plane mid-route instead of looping it.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('.flight-now svg.map').forEach((svg) => {
      svg.setCurrentTime(4.5);
      svg.pauseAnimations();
    });
  }
</script>

<style>
  .flight-now {
    position: relative;
    margin: 1.25rem 0 0.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: #1b2b4b;
    color: #eef2f6;
  }

  .stripe {
    height: 7px;
    background: repeating-linear-gradient(-45deg, #c2272d 0 14px, #f8fafc 14px 21px, #2457a6 21px 35px, #f8fafc 35px 42px);
  }

  .inner {
    display: grid;
    gap: 0.5rem 2rem;
    align-items: center;
    padding: 1.5rem clamp(1rem, 4vw, 2.25rem) 1.25rem;
  }

  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: minmax(0, 1fr) 26rem;
      padding-block: 1.25rem;
    }
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: #f3b7b9;
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #ec5b5f;
    box-shadow: 0 0 0 0 rgba(236, 91, 95, 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 2s ease-out infinite;
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(236, 91, 95, 0.55);
    }
    100% {
      box-shadow: 0 0 0 0.7rem rgba(236, 91, 95, 0);
    }
  }

  .headline {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.2;
    margin-top: 0.6rem;
    color: #f8fafc;
    text-wrap: balance;
  }

  .city {
    color: #ffffff;
    text-decoration: underline;
    text-decoration-color: #ec5b5f;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .sub {
    margin-top: 0.7rem;
    font-size: var(--step--1);
    color: #b9c5d8;
  }

  .map {
    display: block;
    width: 100%;
    height: auto;
    max-width: 26rem;
    justify-self: center;
    /* Soften the edges when a short route is zoomed in past the globe's outline. */
    clip-path: inset(0 round 14px);
  }

  .sea {
    fill: #22365a;
  }

  .graticule {
    fill: none;
    stroke: #2f4670;
    stroke-width: 0.5;
  }

  .land {
    fill: #34507f;
    stroke: #3d5b8d;
    stroke-width: 0.5;
  }

  .sphere-edge {
    fill: none;
    stroke: #3d5b8d;
    stroke-width: 1;
  }

  .route {
    fill: none;
    stroke: #8fb3f2;
    stroke-width: 2;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }

  .end {
    fill: #f8fafc;
    stroke: #1b2b4b;
    stroke-width: 2;
  }

  .code {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    fill: #f8fafc;
    paint-order: stroke;
    stroke: #22365a;
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .plane path {
    fill: #ffffff;
    stroke: #1b2b4b;
    stroke-width: 0.8;
  }
</style>
