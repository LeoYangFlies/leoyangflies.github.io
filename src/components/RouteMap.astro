---
// A globe with every route flown, drawn as great-circle arcs with direction arrows. It is
// rendered to SVG when the site is built, facing wherever the flights are concentrated.
// With `interactive`, visitors can turn it (drag or arrow keys), zoom it (pinch, the
// buttons, + and -, or double-click a spot), and hover or click a route to see its details.
import { geoDistance, geoGraticule10, geoInterpolate, geoOrthographic, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';
import { getAirport } from '../data/airports';
import { ARROW_PATH, arrowMarks, labelsThatFit } from '../lib/globe';

export interface MapLeg {
  from: string;
  to: string;
  /** Flown in both directions (draws a pair of arrows). */
  twoWay?: boolean;
  /** How often it was flown; thicker lines for busier routes. */
  weight?: number;
  /** What the info card shows when the route is clicked. */
  title?: string;
  lines?: string[];
  /** One row per flight on this route, shown as a small table in the card. */
  rows?: MapLegRow[];
  link?: { href: string; label: string };
}

export interface MapLegRow {
  /** Two-letter airline code, used for the logo. */
  code: string;
  airline: string;
  date: string;
  flight: string;
  /** F, J, PE or Y. */
  cabin?: string;
  /** Destination code, shown on routes flown both ways. */
  to?: string;
  /** Link to the review of this flight, if there is one. */
  href?: string;
}

interface Props {
  legs: MapLeg[];
  airports: string[];
  labels?: boolean;
  animate?: boolean;
  interactive?: boolean;
  /** Enlarges dots, codes and arrows on globes shown small, so they stay readable. */
  markScale?: number;
  /** Routes shorter than this on screen (in map units) get no arrow until zoomed in. */
  arrowMinLength?: number;
  /**
   * 'weighted' faces the globe toward the busiest flying (good for a whole logbook);
   * 'spread' centres it between the two farthest airports, so every route sits well
   * inside the globe (good for a single trip).
   */
  centerOn?: 'weighted' | 'spread';
  /** Give short routes a smaller arrow instead of none (for trips, where every flight counts). */
  shrinkArrows?: boolean;
  /** Draw direction arrows on the routes. */
  arrows?: boolean;
  class?: string;
}

const {
  legs,
  airports,
  labels = true,
  animate = false,
  interactive = false,
  markScale = 1,
  arrowMinLength,
  centerOn = 'weighted',
  shrinkArrows = false,
  arrows: showArrows = true,
  class: className,
} = Astro.props;

const SIZE = 600;
const PAD = 14;
const rad = Math.PI / 180;
const uid = Math.random().toString(36).slice(2, 8);
const ARROW_MIN_LENGTH = arrowMinLength ?? 34 * markScale;

const coords = (code: string): [number, number] => {
  const ap = getAirport(code);
  return [ap.lon, ap.lat];
};

// Face the globe toward the middle of all the flying, weighting each route by how often
// it was flown and sampling along each great circle (long routes bend toward the poles).
let x = 0,
  y = 0,
  z = 0;
const samples: [number, number][] = [];
for (const leg of legs) {
  const between = geoInterpolate(coords(leg.from), coords(leg.to));
  const w = leg.weight ?? 1;
  for (let t = 0; t <= 1; t += 0.1) {
    const [lon, lat] = between(t);
    samples.push([lon, lat]);
    x += w * Math.cos(lat * rad) * Math.cos(lon * rad);
    y += w * Math.cos(lat * rad) * Math.sin(lon * rad);
    z += w * Math.sin(lat * rad);
  }
}
let center: [number, number];
if (centerOn === 'spread' && airports.length > 1) {
  // Midway between the two airports farthest apart, tilted no more than needed.
  let pair: [[number, number], [number, number]] = [coords(airports[0]), coords(airports[0])];
  let widest = -1;
  for (const p of airports) {
    for (const q of airports) {
      const d = geoDistance(coords(p), coords(q));
      if (d > widest) {
        widest = d;
        pair = [coords(p), coords(q)];
      }
    }
  }
  const mid = geoInterpolate(pair[0], pair[1])(0.5);
  center = [mid[0], Math.max(-50, Math.min(60, mid[1]))];
} else {
  // Keep the tilt modest so north stays roughly up, like a classroom globe.
  const centerLat = Math.max(-35, Math.min(45, Math.atan2(z, Math.hypot(x, y)) / rad));
  center = [Math.atan2(y, x) / rad, centerLat];
}
const farthest = Math.max(0, ...samples.map((p) => geoDistance(center, p))) / rad;

const projection = geoOrthographic().rotate([-center[0], -center[1]]);
projection.fitExtent(
  [
    [PAD, PAD],
    [SIZE - PAD, SIZE - PAD],
  ],
  { type: 'Sphere' },
);
const wholeGlobeScale = projection.scale();
if (farthest < 40 && samples.length) {
  // Regional routes only: start zoomed in on them, with room around the edges.
  projection.fitExtent(
    [
      [70, 70],
      [SIZE - 70, SIZE - 70],
    ],
    { type: 'MultiPoint', coordinates: samples },
  );
  projection.scale(Math.min(projection.scale(), wholeGlobeScale * 8)).translate([SIZE / 2, SIZE / 2]);
}
const path = geoPath(projection);

const land = path(feature(land110 as any, (land110 as any).objects.land) as any) ?? '';
const sphere = path({ type: 'Sphere' }) ?? '';
const graticule = path(geoGraticule10()) ?? '';

const max = Math.max(1, ...legs.map((l) => l.weight ?? 1));
const many = legs.length > 20;
// Least-flown first, so the busiest routes are drawn on top.
const ordered = legs.map((leg, index) => ({ leg, index })).sort((p, q) => (p.leg.weight ?? 1) - (q.leg.weight ?? 1));
const arcs = ordered.map(({ leg }, i) => {
  const a = coords(leg.from);
  const b = coords(leg.to);
  const d = path({ type: 'LineString', coordinates: [a, b] }) ?? '';
  return {
    leg,
    a,
    b,
    d,
    width: +((many ? 1 : 1.6) + 2.6 * Math.sqrt((leg.weight ?? 1) / max)).toFixed(2),
    // Spread the draw-in over about 1.4 seconds however many routes there are.
    delay: (0.15 + (i / Math.max(1, ordered.length)) * 1.4).toFixed(2),
    arrows: showArrows ? arrowMarks((p) => projection(p), center, a, b, !!leg.twoWay, ARROW_MIN_LENGTH, shrinkArrows) : [],
    label: leg.title ?? `${leg.from} to ${leg.to}`,
  };
});
// With a handful of routes, each one is reachable with the Tab key too.
const tabbable = interactive && arcs.length <= 15;

const points = airports.map((code) => {
  const ap = getAirport(code);
  return { code, city: ap.city, lon: ap.lon, lat: ap.lat };
});

// Airports on the visible side of the globe, with codes only where they have room.
const dots = points.flatMap((p) => {
  if (geoDistance(center, [p.lon, p.lat]) >= Math.PI / 2) return [];
  const xy = projection([p.lon, p.lat]);
  return xy ? [{ ...p, x: xy[0], y: xy[1] }] : [];
});
const fit = labels ? labelsThatFit(dots, SIZE, markScale) : new Map<string, number>();
const fmt = (n: number) => n.toFixed(1);

const top = [...legs].sort((p, q) => (q.weight ?? 1) - (p.weight ?? 1)).slice(0, 5);
const summary = `${legs.length} ${legs.length === 1 ? 'route' : 'routes'}: ${top
  .map((l) => `${l.from} to ${l.to}`)
  .join(', ')}${legs.length > 5 ? ', and more' : ''}`;

// What the browser needs to redraw the globe as it turns and zooms, and to show route details.
const mapData = interactive
  ? JSON.stringify({
      size: SIZE,
      scale: projection.scale(),
      translate: projection.translate(),
      rotate: projection.rotate(),
      markScale,
      arrowMin: ARROW_MIN_LENGTH,
      shrinkArrows,
      showArrows,
      legs: arcs.map((arc) => ({
        a: arc.a,
        b: arc.b,
        twoWay: !!arc.leg.twoWay,
        title: arc.leg.title ?? '',
        lines: arc.leg.lines ?? [],
        rows: arc.leg.rows ?? [],
        link: arc.leg.link ?? null,
      })),
      airports: points,
      labels,
    })
  : undefined;
---

<figure
  class:list={['route-map', className, animate && 'animate', interactive && 'interactive']}
  data-map={mapData}
  style={`--mark: ${markScale}`}
>
  <div class="stage">
    <svg
      viewBox={`0 0 ${SIZE} ${SIZE}`}
      role="img"
      aria-label={`Globe of routes flown, ${summary}`}
      tabindex={interactive ? 0 : undefined}
    >
      <defs>
        <clipPath id={`map-sphere-${uid}`}><path class="sphere-clip" d={sphere} /></clipPath>
        <filter id="route-glow" filterUnits="userSpaceOnUse" x="0" y="0" width={SIZE} height={SIZE}>
          <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
      <g clip-path={`url(#map-sphere-${uid})`}>
        <path class="sea" d={sphere} />
        <path class="graticule" d={graticule} />
        <path class="land" d={land} />
      </g>
      <g class:list={['arcs', many && 'many']}>
        {
          arcs.map((arc, i) => (
            <g class="leg" data-leg={i}>
              <path class="arc" d={arc.d} stroke-width={arc.width} pathLength="1" style={`--d:${arc.delay}s`}>
                {!interactive && <title>{arc.label}</title>}
              </path>
              <g class="arrows" aria-hidden="true">
                {arc.arrows.map((m) => (
                  <path
                    class="arrow"
                    d={ARROW_PATH}
                    transform={`translate(${fmt(m.x)} ${fmt(m.y)}) rotate(${fmt(m.angle)}) scale(${fmt(markScale * m.size)})`}
                  />
                ))}
              </g>
              {interactive && (
                <path
                  class="hit"
                  d={arc.d}
                  stroke-width={Math.max(14, 12 * markScale)}
                  tabindex={tabbable ? 0 : undefined}
                  role={tabbable ? 'button' : undefined}
                  aria-label={tabbable ? arc.label : undefined}
                />
              )}
            </g>
          ))
        }
      </g>
      <g class="airports">
        {
          dots.map((d) => (
            <g>
              <circle cx={d.x} cy={d.y} r={3.5 * markScale}>
                <title>
                  {d.code}, {d.city}
                </title>
              </circle>
              {fit.has(d.code) && (
                <text x={d.x} y={d.y + fit.get(d.code)!} text-anchor="middle">
                  {d.code}
                </text>
              )}
            </g>
          ))
        }
      </g>
    </svg>
    {
      interactive && (
        <>
          <div class="controls" role="group" aria-label="Globe controls">
            <button type="button" data-action="in" aria-label="Zoom in" title="Zoom in">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 3v10M3 8h10" />
              </svg>
            </button>
            <button type="button" data-action="out" aria-label="Zoom out" title="Zoom out">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h10" />
              </svg>
            </button>
            <button type="button" data-action="reset" aria-label="Reset view" title="Reset view">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3.5 8a4.5 4.5 0 1 0 1.3-3.2M3.5 2.5v2.8h2.8" />
              </svg>
            </button>
          </div>
          <div class="leg-info" role="status" hidden>
            <button type="button" class="info-close" aria-label="Close">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" />
              </svg>
            </button>
            <p class="info-title" />
            <ul class="info-lines" />
            <div class="info-table" hidden />
            <a class="info-link" hidden />
          </div>
        </>
      )
    }
  </div>
  {
    interactive && (
      <figcaption class="hint">Drag to turn, pinch or use the buttons to zoom, and tap or click a route for details.</figcaption>
    )
  }
</figure>

<script>
  import { geoDistance, geoGraticule10, geoOrthographic, geoPath } from 'd3-geo';
  import { feature } from 'topojson-client';
  import land110 from 'world-atlas/land-110m.json';
  import { ARROW_PATH, arrowMarks, labelsThatFit } from '../lib/globe';

  const NS = 'http://www.w3.org/2000/svg';
  const MAX_ZOOM = 60;
  const DETAIL_ZOOM = 4; // switch to the detailed coastline from here
  type LonLat = [number, number];
  type Pt = { code: string; city: string; lon: number; lat: number };
  type Leg = {
    a: LonLat;
    b: LonLat;
    twoWay: boolean;
    title: string;
    lines: string[];
    rows: Row[];
    link: { href: string; label: string } | null;
  };
  type Row = {
    code: string;
    airline: string;
    date: string;
    flight: string;
    cabin?: string;
    to?: string;
    href?: string;
  };
  type MapData = {
    size: number;
    scale: number;
    translate: [number, number];
    rotate: [number, number, number];
    markScale: number;
    arrowMin: number;
    shrinkArrows: boolean;
    showArrows: boolean;
    legs: Leg[];
    airports: Pt[];
    labels: boolean;
  };

  const coarseLand = feature(land110 as any, (land110 as any).objects.land) as any;
  let detailedLand: any = null;
  let detailRequested = false;
  const detailListeners: (() => void)[] = [];
  const graticule = geoGraticule10();
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const f1 = (n: number) => n.toFixed(1);

  document.querySelectorAll<HTMLElement>('.route-map[data-map]').forEach((figure) => {
    const data: MapData = JSON.parse(figure.dataset.map!);
    const stage = figure.querySelector<HTMLElement>(':scope > .stage')!;
    const svg = stage.querySelector<SVGSVGElement>(':scope > svg')!;
    const arcsGroup = svg.querySelector('.arcs')!;
    const els = {
      sea: svg.querySelector('.sea')!,
      clip: svg.querySelector('.sphere-clip')!,
      land: svg.querySelector('.land')!,
      graticule: svg.querySelector('.graticule')!,
      legs: [...svg.querySelectorAll<SVGGElement>('.leg')],
      airports: svg.querySelector('.airports')!,
    };
    const buttons = {
      in: figure.querySelector<HTMLButtonElement>('[data-action="in"]')!,
      out: figure.querySelector<HTMLButtonElement>('[data-action="out"]')!,
      reset: figure.querySelector<HTMLButtonElement>('[data-action="reset"]')!,
    };
    const info = {
      box: figure.querySelector<HTMLElement>('.leg-info')!,
      title: figure.querySelector<HTMLElement>('.info-title')!,
      lines: figure.querySelector<HTMLElement>('.info-lines')!,
      table: figure.querySelector<HTMLElement>('.info-table')!,
      link: figure.querySelector<HTMLAnchorElement>('.info-link')!,
      close: figure.querySelector<HTMLButtonElement>('.info-close')!,
    };

    const baseScale = data.scale;
    const projection = geoOrthographic().scale(baseScale).translate(data.translate).rotate(data.rotate);
    const path = geoPath(projection);
    let zoom = 1;
    let selected: number | null = null;

    const viewCenter = (): LonLat => {
      const [l, p] = projection.rotate();
      return [-l, -p];
    };

    function drawAirports() {
      const center = viewCenter();
      const dots: (Pt & { x: number; y: number })[] = [];
      for (const ap of data.airports) {
        if (geoDistance(center, [ap.lon, ap.lat]) >= Math.PI / 2) continue;
        const xy = projection([ap.lon, ap.lat]);
        if (xy) dots.push({ ...ap, x: xy[0], y: xy[1] });
      }
      const fit = data.labels ? labelsThatFit(dots, data.size, data.markScale) : new Map<string, number>();
      const frag = document.createDocumentFragment();
      for (const d of dots) {
        const g = document.createElementNS(NS, 'g');
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', f1(d.x));
        c.setAttribute('cy', f1(d.y));
        c.setAttribute('r', String(3.5 * data.markScale));
        const title = document.createElementNS(NS, 'title');
        title.textContent = `${d.code}, ${d.city}`;
        c.appendChild(title);
        g.appendChild(c);
        const dy = fit.get(d.code);
        if (dy !== undefined) {
          const t = document.createElementNS(NS, 'text');
          t.setAttribute('x', f1(d.x));
          t.setAttribute('y', f1(d.y + dy));
          t.setAttribute('text-anchor', 'middle');
          t.textContent = d.code;
          g.appendChild(t);
        }
        frag.appendChild(g);
      }
      els.airports.replaceChildren(frag);
    }

    function drawLegs() {
      const center = viewCenter();
      for (const g of els.legs) {
        const leg = data.legs[Number(g.dataset.leg)];
        const d = path({ type: 'LineString', coordinates: [leg.a, leg.b] }) ?? '';
        g.querySelector('.arc')!.setAttribute('d', d);
        g.querySelector('.hit')?.setAttribute('d', d);
        const marks = !data.showArrows ? [] : arrowMarks(
          (p) => projection(p) as [number, number] | null,
          center,
          leg.a,
          leg.b,
          leg.twoWay,
          data.arrowMin,
          data.shrinkArrows,
        );
        const arrows = g.querySelector('.arrows')!;
        arrows.replaceChildren(
          ...marks.map((m) => {
            const el = document.createElementNS(NS, 'path');
            el.setAttribute('class', 'arrow');
            el.setAttribute('d', ARROW_PATH);
            el.setAttribute(
              'transform',
              `translate(${f1(m.x)} ${f1(m.y)}) rotate(${f1(m.angle)}) scale(${f1(data.markScale * m.size)})`,
            );
            return el;
          }),
        );
      }
    }

    function draw() {
      const sphere = path({ type: 'Sphere' }) ?? '';
      els.sea.setAttribute('d', sphere);
      els.clip.setAttribute('d', sphere);
      els.land.setAttribute('d', path(zoom >= DETAIL_ZOOM && detailedLand ? detailedLand : coarseLand) ?? '');
      els.graticule.setAttribute('d', path(graticule) ?? '');
      drawLegs();
      drawAirports();
      buttons.in.disabled = zoom >= MAX_ZOOM - 0.01;
      buttons.out.disabled = zoom <= 1.001;
    }

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(draw);
    };

    function loadDetail() {
      if (zoom < DETAIL_ZOOM) return;
      if (detailedLand) return;
      detailListeners.push(schedule);
      if (detailRequested) return;
      detailRequested = true;
      import('world-atlas/land-50m.json').then((m: any) => {
        const topo = m.default ?? m;
        detailedLand = feature(topo, topo.objects.land);
        detailListeners.forEach((fn) => fn());
      });
    }

    // ---------- Route details ----------

    /** Airline logo from a public logo service, falling back to the two-letter code. */
    function logo(row: Row): HTMLElement {
      const box = document.createElement('span');
      box.className = 'logo';
      box.title = row.airline;
      const badge = () => {
        box.replaceChildren(row.code);
        box.classList.add('code');
      };
      if (!/^[A-Z0-9]{2}$/.test(row.code)) {
        badge();
        return box;
      }
      const img = document.createElement('img');
      img.alt = row.airline;
      img.width = 20;
      img.height = 20;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.referrerPolicy = 'no-referrer';
      img.src = `https://pics.avs.io/al_square/40/40/${row.code}@2x.png`;
      img.onerror = badge;
      box.appendChild(img);
      return box;
    }

    function buildTable(rows: Row[]): HTMLTableElement {
      const table = document.createElement('table');
      const head = table.createTHead().insertRow();
      for (const [label, cls] of [
        ['Airline', 'c-logo'],
        ['Date', 'c-date'],
        ['Flight', 'c-flight'],
        ...(rows.some((r) => r.to) ? [['To', 'c-to']] : []),
        ['Class', 'c-cabin'],
      ]) {
        const th = document.createElement('th');
        th.scope = 'col';
        th.className = cls;
        th.textContent = label;
        head.appendChild(th);
      }
      const body = table.createTBody();
      for (const r of rows) {
        const tr = body.insertRow();
        tr.insertCell().appendChild(logo(r));
        const date = tr.insertCell();
        date.className = 'c-date';
        date.textContent = r.date;
        const flight = tr.insertCell();
        flight.className = 'c-flight';
        if (r.href) {
          const a = document.createElement('a');
          a.href = r.href;
          a.textContent = r.flight;
          a.title = 'Read the review';
          flight.appendChild(a);
        } else {
          flight.textContent = r.flight;
        }
        if (rows.some((x) => x.to)) {
          const to = tr.insertCell();
          to.className = 'c-to';
          to.textContent = r.to ? `→ ${r.to}` : '';
        }
        const cabin = tr.insertCell();
        cabin.className = 'c-cabin';
        if (r.cabin) {
          const tag = document.createElement('span');
          tag.className = `cabin cabin-${r.cabin.toLowerCase()}`;
          tag.textContent = r.cabin;
          cabin.appendChild(tag);
        }
      }
      return table;
    }

    function closeInfo() {
      if (selected === null) return;
      selected = null;
      info.box.hidden = true;
      figure.classList.remove('has-selection');
      els.legs.forEach((g) => g.classList.remove('selected'));
    }

    /** Open the card for a route, next to a point given in page (client) coordinates. */
    function openInfo(index: number, clientX: number, clientY: number) {
      const leg = data.legs[index];
      if (!leg.title) return;
      selected = index;
      const g = els.legs.find((el) => Number(el.dataset.leg) === index)!;
      els.legs.forEach((el) => el.classList.toggle('selected', el === g));
      // Bring the chosen route to the front (moving it drops keyboard focus, so put it back).
      const hadFocus = g.contains(document.activeElement);
      arcsGroup.appendChild(g);
      if (hadFocus) g.querySelector<SVGPathElement>('.hit')?.focus();
      figure.classList.add('has-selection');

      info.title.textContent = leg.title;
      info.lines.replaceChildren(
        ...leg.lines.map((line) => {
          const li = document.createElement('li');
          li.textContent = line;
          return li;
        }),
      );
      info.box.classList.toggle('has-table', leg.rows.length > 0);
      info.table.hidden = leg.rows.length === 0;
      info.table.replaceChildren(...(leg.rows.length ? [buildTable(leg.rows)] : []));
      info.table.scrollTop = 0;
      info.link.hidden = !leg.link;
      if (leg.link) {
        info.link.href = leg.link.href;
        info.link.textContent = leg.link.label;
      }

      info.box.hidden = false;
      const s = stage.getBoundingClientRect();
      const w = info.box.offsetWidth;
      const h = info.box.offsetHeight;
      const x = clientX - s.left;
      const y = clientY - s.top;
      const left = clamp(x - w / 2, 4, s.width - w - 4);
      const top = y - h - 14 >= 4 ? y - h - 14 : Math.max(4, Math.min(y + 14, s.height - h - 4));
      info.box.style.left = `${left}px`;
      info.box.style.top = `${top}px`;
    }

    /** The middle of a route on screen, for opening its card from the keyboard. */
    function legMidpoint(g: SVGGElement): [number, number] {
      const arc = g.querySelector<SVGPathElement>('.arc')!;
      const total = arc.getTotalLength();
      const pt = arc.getPointAtLength(total / 2);
      const box = svg.getBoundingClientRect();
      const k = box.width / data.size;
      return [box.left + pt.x * k, box.top + pt.y * k];
    }

    info.close.addEventListener('click', closeInfo);
    document.addEventListener('pointerdown', (e) => {
      if (selected !== null && !figure.contains(e.target as Node)) closeInfo();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeInfo();
    });
    els.legs.forEach((g) => {
      g.querySelector('.hit')?.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key !== 'Enter' && key !== ' ') return;
        e.preventDefault();
        e.stopPropagation();
        const index = Number(g.dataset.leg);
        if (selected === index) return closeInfo();
        const [cx, cy] = legMidpoint(g);
        openInfo(index, cx, cy);
      });
    });

    // ---------- Turning and zooming ----------

    function set(rotation: [number, number, number] | null, newZoom: number | null) {
      closeInfo(); // the card would no longer point at its route
      if (rotation) projection.rotate([rotation[0], clamp(rotation[1], -75, 75), rotation[2]]);
      if (newZoom !== null) {
        zoom = clamp(newZoom, 1, MAX_ZOOM);
        projection.scale(baseScale * zoom);
        loadDetail();
      }
      schedule();
    }

    // Smoothly move to a rotation and zoom (or jump, if reduced motion is on).
    let tween = 0;
    function animateTo(rotation: [number, number, number], newZoom: number) {
      cancelAnimationFrame(tween);
      const target = clamp(newZoom, 1, MAX_ZOOM);
      if (reduceMotion) return set(rotation, target);
      const [l0, p0, g0] = projection.rotate();
      // Take the short way round.
      const dl = ((((rotation[0] - l0) % 360) + 540) % 360) - 180;
      const z0 = zoom;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 380);
        const e = 1 - Math.pow(1 - t, 3);
        set([l0 + dl * e, p0 + (rotation[1] - p0) * e, g0 + (rotation[2] - g0) * e], z0 * Math.pow(target / z0, e));
        if (t < 1) tween = requestAnimationFrame(step);
      };
      tween = requestAnimationFrame(step);
    }

    // Pointer input: one finger or mouse turns, two fingers pinch to zoom, a tap or click
    // on a route opens its details.
    const pointers = new Map<number, { x: number; y: number }>();
    let drag: { x: number; y: number; rotate: [number, number, number] } | null = null;
    let pinch: { dist: number; zoom: number } | null = null;
    let press: { x: number; y: number; leg: number | null; moved: boolean; multi: boolean } | null = null;
    const degreesPerPixel = () =>
      (180 / Math.PI / projection.scale()) * (data.size / svg.getBoundingClientRect().width);
    const distance = () => {
      const [a, b] = [...pointers.values()];
      return Math.hypot(a.x - b.x, a.y - b.y);
    };
    const startDrag = () => {
      const [p] = [...pointers.values()];
      drag = p ? { x: p.x, y: p.y, rotate: projection.rotate() } : null;
    };

    svg.addEventListener('pointerdown', (e) => {
      // Stops the browser from focusing the globe (a frame) or selecting text (a blue wash).
      e.preventDefault();
      cancelAnimationFrame(tween);
      const legEl = (e.target as Element).closest<SVGGElement>('.leg');
      if (pointers.size === 0) {
        press = { x: e.clientX, y: e.clientY, leg: legEl ? Number(legEl.dataset.leg) : null, moved: false, multi: false };
      } else if (press) {
        press.multi = true;
      }
      svg.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 1) startDrag();
      if (pointers.size === 2) {
        drag = null;
        pinch = { dist: distance(), zoom };
      }
      figure.classList.add('dragging');
    });
    svg.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (press && !press.moved && Math.hypot(e.clientX - press.x, e.clientY - press.y) > 5) press.moved = true;
      if (!press?.moved && !pinch) return;
      if (pinch && pointers.size >= 2) {
        set(null, pinch.zoom * (distance() / pinch.dist));
      } else if (drag) {
        const k = degreesPerPixel();
        const [l, p, g] = drag.rotate;
        set([l + (e.clientX - drag.x) * k, p - (e.clientY - drag.y) * k, g], null);
      }
    });
    const release = (e: PointerEvent) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.delete(e.pointerId);
      pinch = null;
      if (pointers.size === 1) startDrag();
      if (pointers.size === 0) {
        drag = null;
        figure.classList.remove('dragging');
        // A tap or click that didn't move: open (or close) a route's details.
        if (press && !press.moved && !press.multi && e.type === 'pointerup') {
          if (press.leg === null || press.leg === selected) closeInfo();
          else openInfo(press.leg, e.clientX, e.clientY);
        }
        press = null;
      }
    };
    svg.addEventListener('pointerup', release);
    svg.addEventListener('pointercancel', release);

    // Trackpad pinch: Chrome and Firefox send ctrl+wheel, Safari sends gesture events.
    svg.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey) return; // plain scrolling keeps scrolling the page
        e.preventDefault();
        set(null, zoom * Math.exp(-e.deltaY * 0.01));
      },
      { passive: false },
    );
    let gestureZoom = 1;
    svg.addEventListener('gesturestart', (e) => {
      e.preventDefault();
      gestureZoom = zoom;
    });
    svg.addEventListener('gesturechange', (e: any) => {
      e.preventDefault();
      set(null, gestureZoom * e.scale);
    });

    // Double-click a spot to centre on it and zoom in.
    svg.addEventListener('dblclick', (e) => {
      e.preventDefault();
      const box = svg.getBoundingClientRect();
      const ratio = data.size / box.width;
      const spot = projection.invert!([(e.clientX - box.left) * ratio, (e.clientY - box.top) * ratio]);
      const [, , g] = projection.rotate();
      if (spot && geoDistance(viewCenter(), spot) < Math.PI / 2) {
        animateTo([-spot[0], -spot[1], g], zoom * 2);
      } else {
        animateTo(projection.rotate(), zoom * 2);
      }
    });

    buttons.in.addEventListener('click', () => animateTo(projection.rotate(), zoom * 1.8));
    buttons.out.addEventListener('click', () => animateTo(projection.rotate(), zoom / 1.8));
    buttons.reset.addEventListener('click', () => animateTo(data.rotate, 1));

    svg.addEventListener('keydown', (e) => {
      const [l, p, g] = projection.rotate();
      const step = 15 / Math.sqrt(zoom);
      const turns: Record<string, [number, number, number]> = {
        ArrowLeft: [l + step, p, g],
        ArrowRight: [l - step, p, g],
        ArrowUp: [l, p - step, g],
        ArrowDown: [l, p + step, g],
      };
      if (turns[e.key]) {
        e.preventDefault();
        set(turns[e.key], null);
      } else if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        animateTo(projection.rotate(), zoom * 1.8);
      } else if (e.key === '-' || e.key === '_') {
        e.preventDefault();
        animateTo(projection.rotate(), zoom / 1.8);
      } else if (e.key === '0') {
        e.preventDefault();
        animateTo(data.rotate, 1);
      }
    });

    figure.classList.add('ready');
    draw();
  });
</script>

<style>
  .route-map {
    margin: 0;
  }

  .stage {
    position: relative;
  }

  .stage > svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .interactive .stage {
    /* No text selection, callouts or tap flashes while dragging the globe. */
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .interactive .stage > svg {
    cursor: grab;
    /* Vertical swipes still scroll the page on phones; sideways swipes turn, two fingers zoom. */
    touch-action: pan-y;
    outline: none;
  }

  .interactive.dragging .stage > svg {
    cursor: grabbing;
  }

  /* A focus ring only for keyboard users, never after a click or drag. */
  .interactive .stage > svg:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: 50%;
  }

  .controls {
    position: absolute;
    right: 0.25rem;
    bottom: 0.25rem;
    display: none;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ready .controls {
    display: flex;
  }

  .controls button {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .controls button:hover:not(:disabled) {
    border-color: var(--ink);
  }

  .controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .controls svg,
  .info-close svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hint {
    text-align: center;
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .sea {
    fill: var(--surface);
    stroke: var(--rule);
    stroke-width: 1;
  }

  .graticule {
    fill: none;
    stroke: var(--rule);
    stroke-width: 0.5;
    opacity: 0.7;
  }

  .land {
    fill: var(--paper-deep);
    stroke: var(--rule);
    stroke-width: 0.6;
  }

  /* ---------- Routes ---------- */

  .arc {
    fill: none;
    stroke: var(--red);
    stroke-linecap: round;
    transition: opacity 0.15s ease;
  }

  .arcs.many .arc {
    stroke-opacity: 0.7;
  }

  .arcs :global(.arrow) {
    fill: var(--red);
    stroke: var(--surface);
    stroke-width: 1.2;
    stroke-linejoin: round;
    transition:
      fill-opacity 0.15s ease,
      stroke-opacity 0.15s ease;
  }

  .hit {
    fill: none;
    stroke: transparent;
    pointer-events: stroke;
    cursor: pointer;
    outline: none;
  }

  /* Hovering or choosing a route makes it glow, and fades the others back. */
  .interactive:not(.dragging) .leg:hover .arc,
  .interactive .leg:has(.hit:focus-visible) .arc,
  .leg.selected .arc {
    stroke-opacity: 1;
    filter: url(#route-glow);
  }

  .interactive:not(.dragging) .arcs:has(.leg:hover) .leg:not(:hover) .arc,
  .interactive .arcs:has(.hit:focus-visible) .leg:not(:has(.hit:focus-visible)) .arc,
  .has-selection .leg:not(.selected) .arc {
    opacity: 0.2;
  }

  .interactive:not(.dragging) .arcs:has(.leg:hover) .leg:not(:hover) :global(.arrow),
  .interactive .arcs:has(.hit:focus-visible) .leg:not(:has(.hit:focus-visible)) :global(.arrow),
  .has-selection .leg:not(.selected) :global(.arrow) {
    fill-opacity: 0.2;
    stroke-opacity: 0.2;
  }

  /* No hover effects while the globe is being dragged. */
  .interactive.dragging .leg:hover:not(.selected) .arc {
    filter: none;
  }

  /* ---------- Airports ---------- */

  .airports :global(circle) {
    fill: var(--ink);
    stroke: var(--surface);
    stroke-width: calc(1.5px * var(--mark, 1));
  }

  .airports :global(text) {
    font-family: var(--font-body);
    font-size: calc(13px * var(--mark, 1));
    font-weight: 700;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: calc(4px * var(--mark, 1));
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* ---------- Route details card ---------- */

  .leg-info {
    position: absolute;
    z-index: 2;
    width: max-content;
    max-width: min(17rem, calc(100% - 0.5rem));
    padding: 0.75rem 2.4rem 0.8rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--red);
    border-radius: var(--radius);
    box-shadow: 0 6px 20px rgba(27, 43, 75, 0.16);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text);
    -webkit-user-select: text;
    user-select: text;
  }

  .leg-info[hidden] {
    display: none;
  }

  .info-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  .info-lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .info-link {
    display: inline-block;
    margin-top: 0.45rem;
    font-weight: 600;
  }

  /* [hidden] must win over the display rules above. */
  .info-link[hidden],
  .info-table[hidden] {
    display: none;
  }

  /* With a table, the short lines become one row of figures under the title. */
  .leg-info.has-table {
    width: min(21rem, calc(100% - 0.5rem));
    max-width: none;
  }

  .has-table .info-lines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 1.1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-weight: 600;
  }

  .info-table {
    max-height: 13.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-right: -1.6rem;
    padding-right: 1.6rem;
  }

  .info-table :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .info-table :global(th) {
    position: sticky;
    top: 0;
    background: var(--surface);
    text-align: left;
    font-weight: 500;
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.45rem 0.5rem 0.3rem 0;
  }

  .info-table :global(th.c-logo) {
    width: 1.75rem;
  }

  .info-table :global(td) {
    padding: 0.32rem 0.5rem 0.32rem 0;
    border-top: 1px solid var(--rule);
    white-space: nowrap;
    vertical-align: middle;
  }

  .info-table :global(.c-cabin) {
    text-align: right;
    padding-right: 0;
  }

  .info-table :global(td.c-flight) {
    color: var(--ink);
    font-weight: 600;
  }

  .info-table :global(.c-to) {
    color: var(--muted);
  }

  .info-table :global(.logo) {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .info-table :global(.logo img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .info-table :global(.logo.code) {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--paper-deep);
  }

  .info-table :global(.cabin) {
    display: inline-block;
    min-width: 1.6rem;
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    border: 1px solid var(--rule);
    color: var(--text);
  }

  .info-table :global(.cabin-f),
  .info-table :global(.cabin-j) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }

  .info-table :global(.cabin-pe) {
    border-color: var(--blue);
    color: var(--blue);
  }

  .info-close {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .info-close:hover {
    background: var(--paper-deep);
    color: var(--ink);
  }

  /* One moment of motion: routes draw themselves in when the Logbook opens. */
  @media (prefers-reduced-motion: no-preference) {
    .animate .arc {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 1.6s cubic-bezier(0.45, 0, 0.2, 1) forwards;
      animation-delay: var(--d);
    }
    .animate .arrows,
    .animate .airports {
      opacity: 0;
      animation: appear 0.5s ease-out forwards;
    }
    .animate .arrows {
      animation-delay: 1.9s;
    }
    .animate .airports {
      animation-delay: 0.1s;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    to {
      opacity: 1;
    }
  }
</style>
