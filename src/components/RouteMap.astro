---
// A globe with every route flown, drawn as great-circle arcs. It is rendered to SVG when
// the site is built, facing wherever the flights are concentrated. With `interactive`,
// visitors can turn it (drag or arrow keys) and zoom it (pinch, the buttons, + and -,
// or double-click a spot).
import { geoDistance, geoGraticule10, geoInterpolate, geoOrthographic, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';
import { getAirport } from '../data/airports';
import { labelsThatFit } from '../lib/globe';
import type { Route } from '../lib/flights';

interface Props {
  routes: Route[];
  airports: string[];
  labels?: boolean;
  animate?: boolean;
  interactive?: boolean;
  class?: string;
}

const { routes, airports, labels = true, animate = false, interactive = false, class: className } = Astro.props;

const SIZE = 600;
const PAD = 14;
const rad = Math.PI / 180;
const uid = Math.random().toString(36).slice(2, 8);

// Face the globe toward the middle of all the flying, weighting each route by how often
// it was flown and sampling along each great circle (long routes bend toward the poles).
let x = 0,
  y = 0,
  z = 0;
const samples: [number, number][] = [];
for (const r of routes) {
  const a = getAirport(r.a);
  const b = getAirport(r.b);
  const between = geoInterpolate([a.lon, a.lat], [b.lon, b.lat]);
  for (let t = 0; t <= 1; t += 0.1) {
    const [lon, lat] = between(t);
    samples.push([lon, lat]);
    x += r.count * Math.cos(lat * rad) * Math.cos(lon * rad);
    y += r.count * Math.cos(lat * rad) * Math.sin(lon * rad);
    z += r.count * Math.sin(lat * rad);
  }
}
// Keep the tilt modest so north stays roughly up, like a classroom globe.
const centerLat = Math.max(-35, Math.min(45, Math.atan2(z, Math.hypot(x, y)) / rad));
const center: [number, number] = [Math.atan2(y, x) / rad, centerLat];
const farthest = Math.max(0, ...samples.map((p) => geoDistance(center, p))) / rad;

const projection = geoOrthographic().rotate([-center[0], -center[1]]);
projection.fitExtent(
  [
    [PAD, PAD],
    [SIZE - PAD, SIZE - PAD],
  ],
  { type: 'Sphere' },
);
const wholeGlobeScale = projection.scale();
if (farthest < 40 && samples.length) {
  // Regional routes only: start zoomed in on them, with room around the edges.
  projection.fitExtent(
    [
      [70, 70],
      [SIZE - 70, SIZE - 70],
    ],
    { type: 'MultiPoint', coordinates: samples },
  );
  projection.scale(Math.min(projection.scale(), wholeGlobeScale * 8)).translate([SIZE / 2, SIZE / 2]);
}
const path = geoPath(projection);

const land = path(feature(land110 as any, (land110 as any).objects.land) as any) ?? '';
const sphere = path({ type: 'Sphere' }) ?? '';
const graticule = path(geoGraticule10()) ?? '';

const max = Math.max(1, ...routes.map((r) => r.count));
const many = routes.length > 20;
// Least-flown first, so the busiest routes are drawn on top.
const ordered = [...routes].sort((p, q) => p.count - q.count);
const arcs = ordered.map((r, i) => {
  const a = getAirport(r.a);
  const b = getAirport(r.b);
  const coords: [[number, number], [number, number]] = [
    [a.lon, a.lat],
    [b.lon, b.lat],
  ];
  return {
    coords,
    d: path({ type: 'LineString', coordinates: coords }) ?? '',
    width: +((many ? 1 : 1.6) + 2.6 * Math.sqrt(r.count / max)).toFixed(2),
    // Spread the draw-in over about 1.4 seconds however many routes there are.
    delay: (0.15 + (i / Math.max(1, ordered.length)) * 1.4).toFixed(2),
    label: `${r.a} – ${r.b}: ${r.count} ${r.count === 1 ? 'flight' : 'flights'}`,
  };
});

const points = airports.map((code) => {
  const ap = getAirport(code);
  return { code, city: ap.city, lon: ap.lon, lat: ap.lat };
});

// Airports on the visible side of the globe, with codes only where they have room.
const dots = points.flatMap((p) => {
  if (geoDistance(center, [p.lon, p.lat]) >= Math.PI / 2) return [];
  const xy = projection([p.lon, p.lat]);
  return xy ? [{ ...p, x: xy[0], y: xy[1] }] : [];
});
const fit = labels ? labelsThatFit(dots, SIZE) : new Map<string, number>();

const top = [...routes].sort((p, q) => q.count - p.count).slice(0, 5);
const summary = `${routes.length} ${routes.length === 1 ? 'route' : 'routes'}; most flown: ${top
  .map((r) => `${r.a}–${r.b} (${r.count})`)
  .join(', ')}`;

// What the browser needs to redraw the globe as it turns and zooms.
const mapData = interactive
  ? JSON.stringify({
      size: SIZE,
      scale: projection.scale(),
      translate: projection.translate(),
      rotate: projection.rotate(),
      routes: arcs.map((a) => a.coords),
      airports: points,
      labels,
    })
  : undefined;
---

<figure class:list={['route-map', className, animate && 'animate', interactive && 'interactive']} data-map={mapData}>
  <div class="stage">
    <svg
      viewBox={`0 0 ${SIZE} ${SIZE}`}
      role="img"
      aria-label={`Globe of routes flown: ${summary}`}
      tabindex={interactive ? 0 : undefined}
    >
      <defs>
        <clipPath id={`map-sphere-${uid}`}><path class="sphere-clip" d={sphere} /></clipPath>
      </defs>
      <g clip-path={`url(#map-sphere-${uid})`}>
        <path class="sea" d={sphere} />
        <path class="graticule" d={graticule} />
        <path class="land" d={land} />
      </g>
      <g class:list={['arcs', many && 'many']}>
        {
          arcs.map((a) => (
            <path d={a.d} stroke-width={a.width} pathLength="1" style={`--d:${a.delay}s`}>
              <title>{a.label}</title>
            </path>
          ))
        }
      </g>
      <g class="airports">
        {
          dots.map((d) => (
            <g>
              <circle cx={d.x} cy={d.y} r="3.5">
                <title>
                  {d.code}, {d.city}
                </title>
              </circle>
              {fit.has(d.code) && (
                <text x={d.x} y={d.y + fit.get(d.code)!} text-anchor="middle">
                  {d.code}
                </text>
              )}
            </g>
          ))
        }
      </g>
    </svg>
    {
      interactive && (
        <div class="controls" role="group" aria-label="Globe controls">
          <button type="button" data-action="in" aria-label="Zoom in" title="Zoom in">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 3v10M3 8h10" />
            </svg>
          </button>
          <button type="button" data-action="out" aria-label="Zoom out" title="Zoom out">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 8h10" />
            </svg>
          </button>
          <button type="button" data-action="reset" aria-label="Reset view" title="Reset view">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3.5 8a4.5 4.5 0 1 0 1.3-3.2M3.5 2.5v2.8h2.8" />
            </svg>
          </button>
        </div>
      )
    }
  </div>
  {interactive && <figcaption class="hint">Drag to turn the globe. Pinch, double-click or use the buttons to zoom.</figcaption>}
</figure>

<script>
  import { geoDistance, geoGraticule10, geoOrthographic, geoPath } from 'd3-geo';
  import { feature } from 'topojson-client';
  import land110 from 'world-atlas/land-110m.json';
  import { labelsThatFit } from '../lib/globe';

  const NS = 'http://www.w3.org/2000/svg';
  const MAX_ZOOM = 60;
  const DETAIL_ZOOM = 4; // switch to the detailed coastline from here
  type Pt = { code: string; city: string; lon: number; lat: number };
  type MapData = {
    size: number;
    scale: number;
    translate: [number, number];
    rotate: [number, number, number];
    routes: [[number, number], [number, number]][];
    airports: Pt[];
    labels: boolean;
  };

  const coarseLand = feature(land110 as any, (land110 as any).objects.land) as any;
  let detailedLand: any = null;
  let detailRequested = false;
  const graticule = geoGraticule10();
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  document.querySelectorAll<HTMLElement>('.route-map[data-map]').forEach((figure) => {
    const data: MapData = JSON.parse(figure.dataset.map!);
    const svg = figure.querySelector<SVGSVGElement>(':scope > .stage > svg')!;
    const els = {
      sea: svg.querySelector('.sea')!,
      clip: svg.querySelector('.sphere-clip')!,
      land: svg.querySelector('.land')!,
      graticule: svg.querySelector('.graticule')!,
      arcs: [...svg.querySelectorAll<SVGPathElement>('.arcs path')],
      airports: svg.querySelector('.airports')!,
    };
    const buttons = {
      in: figure.querySelector<HTMLButtonElement>('[data-action="in"]')!,
      out: figure.querySelector<HTMLButtonElement>('[data-action="out"]')!,
      reset: figure.querySelector<HTMLButtonElement>('[data-action="reset"]')!,
    };

    const baseScale = data.scale;
    const projection = geoOrthographic().scale(baseScale).translate(data.translate).rotate(data.rotate);
    const path = geoPath(projection);
    let zoom = 1;

    function drawAirports() {
      const [l, p] = projection.rotate();
      const center: [number, number] = [-l, -p];
      const dots: (Pt & { x: number; y: number })[] = [];
      for (const ap of data.airports) {
        if (geoDistance(center, [ap.lon, ap.lat]) >= Math.PI / 2) continue;
        const xy = projection([ap.lon, ap.lat]);
        if (xy) dots.push({ ...ap, x: xy[0], y: xy[1] });
      }
      const fit = data.labels ? labelsThatFit(dots, data.size) : new Map<string, number>();
      const frag = document.createDocumentFragment();
      for (const d of dots) {
        const g = document.createElementNS(NS, 'g');
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', d.x.toFixed(1));
        c.setAttribute('cy', d.y.toFixed(1));
        c.setAttribute('r', '3.5');
        const title = document.createElementNS(NS, 'title');
        title.textContent = `${d.code}, ${d.city}`;
        c.appendChild(title);
        g.appendChild(c);
        const dy = fit.get(d.code);
        if (dy !== undefined) {
          const t = document.createElementNS(NS, 'text');
          t.setAttribute('x', d.x.toFixed(1));
          t.setAttribute('y', (d.y + dy).toFixed(1));
          t.setAttribute('text-anchor', 'middle');
          t.textContent = d.code;
          g.appendChild(t);
        }
        frag.appendChild(g);
      }
      els.airports.replaceChildren(frag);
    }

    function draw() {
      const sphere = path({ type: 'Sphere' }) ?? '';
      els.sea.setAttribute('d', sphere);
      els.clip.setAttribute('d', sphere);
      els.land.setAttribute('d', path(zoom >= DETAIL_ZOOM && detailedLand ? detailedLand : coarseLand) ?? '');
      els.graticule.setAttribute('d', path(graticule) ?? '');
      els.arcs.forEach((el, i) => {
        el.setAttribute('d', path({ type: 'LineString', coordinates: data.routes[i] }) ?? '');
      });
      drawAirports();
      buttons.in.disabled = zoom >= MAX_ZOOM - 0.01;
      buttons.out.disabled = zoom <= 1.001;
    }

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(draw);
    };

    function loadDetail() {
      if (detailRequested || zoom < DETAIL_ZOOM) return;
      detailRequested = true;
      import('world-atlas/land-50m.json').then((m: any) => {
        const topo = m.default ?? m;
        detailedLand = feature(topo, topo.objects.land);
        schedule();
      });
    }

    function set(rotation: [number, number, number] | null, newZoom: number | null) {
      if (rotation) projection.rotate([rotation[0], clamp(rotation[1], -75, 75), rotation[2]]);
      if (newZoom !== null) {
        zoom = clamp(newZoom, 1, MAX_ZOOM);
        projection.scale(baseScale * zoom);
        loadDetail();
      }
      schedule();
    }

    // Smoothly move to a rotation and zoom (or jump, if reduced motion is on).
    let tween = 0;
    function animateTo(rotation: [number, number, number], newZoom: number) {
      cancelAnimationFrame(tween);
      const target = clamp(newZoom, 1, MAX_ZOOM);
      if (reduceMotion) return set(rotation, target);
      const [l0, p0, g0] = projection.rotate();
      // Take the short way round.
      const dl = ((((rotation[0] - l0) % 360) + 540) % 360) - 180;
      const z0 = zoom;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 380);
        const e = 1 - Math.pow(1 - t, 3);
        set([l0 + dl * e, p0 + (rotation[1] - p0) * e, g0 + (rotation[2] - g0) * e], z0 * Math.pow(target / z0, e));
        if (t < 1) tween = requestAnimationFrame(step);
      };
      tween = requestAnimationFrame(step);
    }

    // Pointer input: one finger or mouse turns, two fingers pinch to zoom.
    const pointers = new Map<number, { x: number; y: number }>();
    let drag: { x: number; y: number; rotate: [number, number, number] } | null = null;
    let pinch: { dist: number; zoom: number } | null = null;
    const degreesPerPixel = () =>
      (180 / Math.PI / projection.scale()) * (data.size / svg.getBoundingClientRect().width);
    const distance = () => {
      const [a, b] = [...pointers.values()];
      return Math.hypot(a.x - b.x, a.y - b.y);
    };
    const startDrag = () => {
      const [p] = [...pointers.values()];
      drag = p ? { x: p.x, y: p.y, rotate: projection.rotate() } : null;
    };

    svg.addEventListener('pointerdown', (e) => {
      // Stops the browser from focusing the globe (the frame) or selecting text (the blue wash).
      e.preventDefault();
      cancelAnimationFrame(tween);
      svg.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 1) startDrag();
      if (pointers.size === 2) {
        drag = null;
        pinch = { dist: distance(), zoom };
      }
      figure.classList.add('dragging');
    });
    svg.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pinch && pointers.size >= 2) {
        set(null, pinch.zoom * (distance() / pinch.dist));
      } else if (drag) {
        const k = degreesPerPixel();
        const [l, p, g] = drag.rotate;
        set([l + (e.clientX - drag.x) * k, p - (e.clientY - drag.y) * k, g], null);
      }
    });
    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      pinch = null;
      if (pointers.size === 1) startDrag();
      if (pointers.size === 0) {
        drag = null;
        figure.classList.remove('dragging');
      }
    };
    svg.addEventListener('pointerup', release);
    svg.addEventListener('pointercancel', release);

    // Trackpad pinch: Chrome and Firefox send ctrl+wheel, Safari sends gesture events.
    svg.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey) return; // plain scrolling keeps scrolling the page
        e.preventDefault();
        set(null, zoom * Math.exp(-e.deltaY * 0.01));
      },
      { passive: false },
    );
    let gestureZoom = 1;
    svg.addEventListener('gesturestart', (e) => {
      e.preventDefault();
      gestureZoom = zoom;
    });
    svg.addEventListener('gesturechange', (e: any) => {
      e.preventDefault();
      set(null, gestureZoom * e.scale);
    });

    // Double-click a spot to centre on it and zoom in.
    svg.addEventListener('dblclick', (e) => {
      e.preventDefault();
      const box = svg.getBoundingClientRect();
      const ratio = data.size / box.width;
      const spot = projection.invert!([(e.clientX - box.left) * ratio, (e.clientY - box.top) * ratio]);
      const [, , g] = projection.rotate();
      if (spot && geoDistance([-projection.rotate()[0], -projection.rotate()[1]], spot) < Math.PI / 2) {
        animateTo([-spot[0], -spot[1], g], zoom * 2);
      } else {
        animateTo(projection.rotate(), zoom * 2);
      }
    });

    buttons.in.addEventListener('click', () => animateTo(projection.rotate(), zoom * 1.8));
    buttons.out.addEventListener('click', () => animateTo(projection.rotate(), zoom / 1.8));
    buttons.reset.addEventListener('click', () => animateTo(data.rotate, 1));

    svg.addEventListener('keydown', (e) => {
      const [l, p, g] = projection.rotate();
      const step = 15 / Math.sqrt(zoom);
      const turns: Record<string, [number, number, number]> = {
        ArrowLeft: [l + step, p, g],
        ArrowRight: [l - step, p, g],
        ArrowUp: [l, p - step, g],
        ArrowDown: [l, p + step, g],
      };
      if (turns[e.key]) {
        e.preventDefault();
        set(turns[e.key], null);
      } else if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        animateTo(projection.rotate(), zoom * 1.8);
      } else if (e.key === '-' || e.key === '_') {
        e.preventDefault();
        animateTo(projection.rotate(), zoom / 1.8);
      } else if (e.key === '0') {
        e.preventDefault();
        animateTo(data.rotate, 1);
      }
    });

    figure.classList.add('ready');
    draw();
  });
</script>

<style>
  .route-map {
    margin: 0;
  }

  .stage {
    position: relative;
  }

  .stage > svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .interactive .stage {
    /* No text selection, callouts or tap flashes while dragging the globe. */
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  .interactive .stage > svg {
    cursor: grab;
    /* Vertical swipes still scroll the page on phones; sideways swipes turn, two fingers zoom. */
    touch-action: pan-y;
    outline: none;
  }

  .interactive.dragging .stage > svg {
    cursor: grabbing;
  }

  /* A focus ring only for keyboard users, never after a click or drag. */
  .interactive .stage > svg:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: 50%;
  }

  .controls {
    position: absolute;
    right: 0.25rem;
    bottom: 0.25rem;
    display: none;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ready .controls {
    display: flex;
  }

  .controls button {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .controls button:hover:not(:disabled) {
    border-color: var(--ink);
  }

  .controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .controls svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hint {
    text-align: center;
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .sea {
    fill: var(--surface);
    stroke: var(--rule);
    stroke-width: 1;
  }

  .graticule {
    fill: none;
    stroke: var(--rule);
    stroke-width: 0.5;
    opacity: 0.7;
  }

  .land {
    fill: var(--paper-deep);
    stroke: var(--rule);
    stroke-width: 0.6;
  }

  .arcs path {
    fill: none;
    stroke: var(--red);
    stroke-linecap: round;
  }

  .arcs.many path {
    stroke-opacity: 0.7;
  }

  .airports :global(circle) {
    fill: var(--ink);
    stroke: var(--surface);
    stroke-width: 1.5;
  }

  .airports :global(text) {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* One moment of motion: routes draw themselves in when the Logbook opens. */
  @media (prefers-reduced-motion: no-preference) {
    .animate .arcs path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 1.6s cubic-bezier(0.45, 0, 0.2, 1) forwards;
      animation-delay: var(--d);
    }
    .animate .airports {
      opacity: 0;
      animation: appear 0.5s ease-out 0.1s forwards;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    to {
      opacity: 1;
    }
  }
</style>
